generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ImageStatus {
  PENDING
  PROCESSING
  FAILED
  COMPLETED
}

model Photo {
  id String @id @default(uuid())
  originalName String
  fileName String 
  path String
  size Int
  status ImageStatus
  mimeType String
  createdAt DateTime @default(now())

  @@map("photo")
}
